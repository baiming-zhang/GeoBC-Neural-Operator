    "science": {
      "tensor_slots": [
        "xx",
        "yy",
        "zz",
        "xy",
        "xz",
        "yz"
      ],
      "tensor_shear": true,
      "unit": "MPa",
      "formula": "sqrt(0.5*((xx-yy)^2+(yy-zz)^2+(zz-xx)^2)+3*(xy^2+xz^2+yz^2))",
      "comparison": "q versus abs(original cached signed stress), diagnostic magnitude-only; never overwrite labels or claim source scalar/sign formula",
      "device": "CUDA FP64 vectorized",
      "maximum_cumulative_stage_wall_seconds": 60,
      "budget_covers": "metadata, cached I/O, value identity, H2D, q, all metrics, persistence, resume; no reset",
