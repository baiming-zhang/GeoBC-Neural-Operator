        },
        "other": "inconclusive",
        "invalid": "null/missing required metric, empty validity, nonfinite or identity failure => diagnostic_invalid; never strong support",
        "limitations": "No unique causal attribution; no sign/exporter identification; low q error does not validate full signed stress; no old recipe rescue or automatic sweeps"
